@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/Modules")

if(@BIOMEVAL_INCLUDED_BERKELEYDB@)
	find_dependency(BERKELEYDB)
endif()
find_dependency(JPEG)
find_dependency(OpenJPEG)
if(@BIOMEVAL_INCLUDED_OPENSSL@)
	find_dependency(OpenSSL)
endif()
find_dependency(PNG)
if(@BIOMEVAL_INCLUDED_SQLITE3@)
	find_dependency(SQLite3)
endif()
find_dependency(TIFF)
if(@BIOMEVAL_INCLUDED_LERC@)
	find_dependency(Lerc)
endif()
if(@BIOMEVAL_INCLUDED_ZSTD@)
	find_dependency(zstd)
endif()
if(@BIOMEVAL_INCLUDED_LZMA@)
	find_dependency(LibLZMA)
endif()
if(@BIOMEVAL_INCLUDED_DEFLATE@)
	find_dependency(deflate)
endif()

if(@BIOMEVAL_INCLUDED_FFMPEG@)
	find_dependency(FFMPEG)
endif()

if(@BIOMEVAL_INCLUDED_HWLOC@)
	find_dependency(HWLOC)
endif()

if(@BIOMEVAL_INCLUDED_PCSC@)
	find_dependency(PCSC)
endif()

if(@BIOMEVAL_INCLUDED_MPI@)
	find_dependency(MPI)
endif()

if(NOT TARGET biomeval::biomeval)
    include(${CMAKE_CURRENT_LIST_DIR}/biomeval-targets.cmake)
    set_and_check(biomeval_INCLUDE_DIR "@PACKAGE_BIOMEVAL_PUBLIC_HEADER_INCLUDE_DIR@")
endif()

check_required_components(biomeval)
